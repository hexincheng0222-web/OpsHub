# OpsHub 生产环境配置
# 复制此文件为 .env 并修改

# 服务端口
PORT=3001

# 数据库路径（相对于项目根目录）
DB_PATH=./data/opshub.db

# 节点运行环境：production 启动定时调度器，development 不启动
NODE_ENV=development

# 启用服务健康检查定时巡检（1 开启，0 关闭）；production 模式下默认开启
ENABLE_SVC_CRON=1

# 健康检查定时巡检间隔（分钟），默认 10
SVC_CRON_MIN=10

# 服务凭据加密密钥（AES-256-GCM，必须 32 字节 = 64 位十六进制字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ 生产环境务必修改为随机值，泄露会导致服务凭据（密码/token）可被解密
OPS_CRED_KEY=

# JWT 签名密钥（用于登录 token）；生产环境务必修改
JWT_SECRET=

# CORS 允许的跨域来源（逗号分隔），默认支持 localhost:5173 和 localhost:3001
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# ATCOM 话机默认管理员密码（仅当 phones.ts 未配置单独凭据时使用）
ADMIN_DEFAULT_PASSWORD=admin
