# 统一行尾规范为 LF
# 所有文本文件检出时使用 LF
* text=auto

# 源代码
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# 二进制文件
*.db binary
*.db-shm binary
*.db-wal binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
